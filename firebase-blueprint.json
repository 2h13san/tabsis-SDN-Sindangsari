      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nis": { "type": "string" },
        "nisn": { "type": "string" },
        "nama": { "type": "string" },
        "kelas": { "type": "string" },
        "jenis_kelamin": { "type": "string" },
        "nama_orang_tua": { "type": "string" },
