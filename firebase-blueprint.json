    "settings": {
      "title": "settings",
      "description": "Application configurations and school settings",
      "type": "object",
      "properties": {
        "nama_sekolah": { "type": "string" },
        "npsn": { "type": "string" },
        "alamat": { "type": "string" },
        "kepala_sekolah": { "type": "string" },
        "nip_kepala_sekolah": { "type": "string" },
        "bendahara": { "type": "string" },
